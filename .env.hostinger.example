# Salin menjadi .env di server Hostinger, lalu isi bagian bertanda <...>.
APP_NAME="Ruang Kuesioner"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<domain-anda>
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# Wajib false di hosting: semua halaman admin perlu login (buat akun: php artisan admin:buat email@anda).
ADMIN_OPEN_ON_LAN=false

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database MySQL dari hPanel → Databases → MySQL Databases.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<u123456789_kuesioner>
DB_USERNAME=<u123456789_admin>
DB_PASSWORD=<kata-sandi-database>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Antrean dijalankan cron "schedule:run" setiap menit (lihat DEPLOY-HOSTINGER.md).
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

# Opsional: kompres PDF unggahan bila Ghostscript tersedia di server.
GHOSTSCRIPT_PATH=
